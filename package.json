{
  "name": "auth-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "Node.js auth server for Sesori Mobile App",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26.13.1 <27.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:prod": "sops exec-env env/app/prod.env 'tsx src/index.ts'",
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 'tests/**/*.test.ts'",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint --fix src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "generate-keys": "bash ./scripts/generate-keys.sh",
    "env:init": "bash ./scripts/env-init.sh",
    "env:decrypt": "sh -c 'sops decrypt env/app/${ENV:-prod}.env > .env && echo \"Decrypted env/app/${ENV:-prod}.env → .env\"'",
    "env:edit": "sh -c 'sops edit env/app/${ENV:-prod}.env'",
    "env:update-keys": "sh -c 'for f in env/app/*.env; do [ -f \"$f\" ] && sops updatekeys -y \"$f\"; done'",
    "create-password-account": "tsx scripts/create-password-account.ts",
    "backfill-activation": "tsx src/scripts/backfill-activation.ts",
    "backfill-product-analytics-preference": "tsx src/scripts/backfill-product-analytics-preference.ts",
    "export-product-analytics": "tsx src/scripts/export-product-analytics.ts",
    "suppress-product-analytics-export": "tsx src/scripts/suppress-product-analytics-export.ts",
    "purge-soniox-transcription": "tsx src/scripts/purge-soniox-transcription.ts",
    "optional-email:dry-run": "tsx src/scripts/dry-run-setup-reminders.ts",
    "circular-dependencies": "madge --circular --ts-config ./tsconfig.json ./src/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.8",
    "@fastify/proxy-addr": "^5.1.2",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.3.7",
    "@google-cloud/bigquery": "^9.6.1",
    "@soniox/node": "^2.5.0",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.1",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "mongodb": "^7.9.0",
    "music-metadata": "^12.5.0",
    "openai": "^7.57.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "madge": "^8.0.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "madge": {
      "typescript": "$typescript"
    }
  }
}
